# Public site URL (used later for canonical / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Form delivery (Stage 6). Leave unset to log submissions in development.
FORM_WEBHOOK_URL=
FORM_TO_EMAIL=forum@esgpartners.kz

# Optional spam protection / rate limit backend
FORM_RATE_LIMIT_PER_HOUR=20

# Cloudflare Turnstile. Required before production stores a form.
# The site key is public. The secret stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payment adapter (Stage 6). Until connected, invoices are generated from applications.
PAYMENT_PROVIDER=invoice
PAYMENT_WEBHOOK_SECRET=
